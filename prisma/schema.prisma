// Narra — Prisma Schema
// Base de données narrative pour œuvres de fiction

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// UTILISATEURS
// ============================================================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  kyrosSub     String?  @unique @map("kyros_sub")
  email        String   @unique
  name         String?
  passwordHash String?
  avatarUrl    String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  projects      Project[]
  collaborations ProjectCollaborator[]
  invitesSent   ProjectInvite[]
  readingProgresses ReadingProgress[]

  @@map("users")
}

// ============================================================
// PROJETS
// ============================================================

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  coverUrl    String?   @map("cover_url")
  type        String    @default("story")
  status      String    @default("idea")
  pageTitle           String?  @map("page_title")
  pageSubtitle        String?  @map("page_subtitle")
  pageBackgroundUrl   String?  @map("page_background_url")
  pageBackgroundColor String   @default("#09090b") @map("page_background_color")
  pageTextColor       String   @default("#fafafa") @map("page_text_color")
  pageAccentColor     String   @default("#f59e0b") @map("page_accent_color")
  pageTheme           String   @default("editorial") @map("page_theme")
  pagePublished       Boolean  @default(false) @map("page_published")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  ownerId String @map("owner_id") @db.Uuid
  owner   User   @relation(fields: [ownerId], references: [id])

  genres ProjectGenre[]
  tags   EntityTag[]    @relation("TaggedProject")

  collaborators ProjectCollaborator[]
  invites       ProjectInvite[]

  narrativeNodes NarrativeNode[]
  scenes         Scene[]
  characters     Character[]
  locations      Location[]
  organizations  Organization[]
  loreEntries    LoreEntry[]
  timelineEvents TimelineEvent[]
  media          Media[]
  readingProgresses ReadingProgress[]

  @@index([ownerId])
  @@index([deletedAt])
  @@map("projects")
}

model ProjectGenre {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  genre     String

  @@unique([projectId, genre])
  @@map("project_genres")
}

// ============================================================
// STRUCTURE NARRATIVE
// ============================================================

model NarrativeNode {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId String?         @map("parent_id") @db.Uuid
  parent   NarrativeNode?  @relation("NodeHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children NarrativeNode[] @relation("NodeHierarchy")

  type        String
  title       String
  description String?
  order       Int     @default(0)
  depth       Int     @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  scenes Scene[]

  @@index([projectId])
  @@index([parentId])
  @@index([projectId, parentId, order])
  @@map("narrative_nodes")
}

// ============================================================
// SCÈNES
// ============================================================

model Scene {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  nodeId String?        @map("node_id") @db.Uuid
  node   NarrativeNode? @relation(fields: [nodeId], references: [id], onDelete: SetNull)

  title     String
  status    String  @default("draft")
  order     Int     @default(0)
  wordCount Int     @default(0) @map("word_count")
  notes     String?

  locationId String?   @map("location_id") @db.Uuid
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  blocks         SceneBlock[]
  tags           EntityTag[]      @relation("TaggedScene")
  characters     SceneCharacter[]
  timelineEvents TimelineEvent[]  @relation("TimelineScenes")
  readingProgresses ReadingProgress[]

  @@index([projectId])
  @@index([nodeId])
  @@index([projectId, nodeId, order])
  @@map("scenes")
}

model SceneCharacter {
  id          String    @id @default(uuid()) @db.Uuid
  sceneId     String    @map("scene_id") @db.Uuid
  scene       Scene     @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([sceneId, characterId])
  @@map("scene_characters")
}

// ============================================================
// BLOCS DE SCÈNE
// ============================================================

model SceneBlock {
  id      String @id @default(uuid()) @db.Uuid
  sceneId String @map("scene_id") @db.Uuid
  scene   Scene  @relation(fields: [sceneId], references: [id], onDelete: Cascade)

  type    String
  content String
  order   Int    @default(0)

  characterId String?    @map("character_id") @db.Uuid
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  emotion     String?
  position    String?
  speakerNote String?    @map("speaker_note")
  mediaUrl    String?    @map("media_url")
  displayMode String?    @map("display_mode")
  showPortrait Boolean   @default(true) @map("show_portrait")
  portraitImageUrl String? @map("portrait_image_url")
  audioAction String?    @map("audio_action")
  volume      Int?       @default(100)
  fadeDuration Float?    @map("fade_duration")
  loop        Boolean?   @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  readingProgresses ReadingProgress[]

  @@index([sceneId, order])
  @@map("scene_blocks")
}

// ============================================================
// PERSONNAGES
// ============================================================

model Character {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  firstName   String? @map("first_name")
  lastName    String? @map("last_name")
  alias       String?
  portraitUrl String? @map("portrait_url")
  nameColor   String  @default("#f59e0b") @map("name_color")
  role        String?
  description String?
  biography   String?
  age         String?
  birthDate   String? @map("birth_date")
  status      String? @default("active")
  personality String?
  motivations String?
  strengths   String?
  weaknesses  String?
  notes       String?
  quotes      String? @map("important_quotes")
  wikiSections Json   @default("[]") @map("wiki_sections")
  promptNotes String? @map("prompt_notes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  relationsFrom CharacterRelation[] @relation("FromCharacter")
  relationsTo   CharacterRelation[] @relation("ToCharacter")

  sceneAppearances SceneCharacter[]
  sceneBlocks      SceneBlock[]

  organizationMemberships OrganizationMember[]
  timelineEvents          TimelineEventCharacter[]
  tags                    EntityTag[]              @relation("TaggedCharacter")
  images                  CharacterImage[]

  @@index([projectId])
  @@index([deletedAt])
  @@map("characters")
}

model CharacterImage {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  label       String
  emotion     String
  url         String
  order       Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([characterId, order])
  @@map("character_images")
}

model CharacterRelation {
  id              String    @id @default(uuid()) @db.Uuid
  fromCharacterId String    @map("from_character_id") @db.Uuid
  fromCharacter   Character @relation("FromCharacter", fields: [fromCharacterId], references: [id], onDelete: Cascade)
  toCharacterId   String    @map("to_character_id") @db.Uuid
  toCharacter     Character @relation("ToCharacter", fields: [toCharacterId], references: [id], onDelete: Cascade)

  type          String
  label         String?
  description   String?
  bidirectional Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fromCharacterId, toCharacterId, type])
  @@map("character_relations")
}

// ============================================================
// LIEUX
// ============================================================

model Location {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  parentId String?    @map("parent_id") @db.Uuid
  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[] @relation("LocationHierarchy")

  name            String
  type            String?
  description     String?
  imageUrl        String? @map("image_url")
  textualLocation String? @map("textual_location")
  ambiance        String?
  notes           String?
  promptNotes     String? @map("prompt_notes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  scenes         Scene[]
  timelineEvents TimelineEvent[]
  tags           EntityTag[]     @relation("TaggedLocation")

  @@index([projectId])
  @@index([parentId])
  @@index([deletedAt])
  @@map("locations")
}

// ============================================================
// ORGANISATIONS
// ============================================================

model Organization {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name        String
  logoUrl     String? @map("logo_url")
  description String?
  type        String?
  status      String? @default("active")
  notes       String?
  promptNotes String? @map("prompt_notes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  members        OrganizationMember[]
  relationsFrom  OrganizationRelation[] @relation("FromOrg")
  relationsTo    OrganizationRelation[] @relation("ToOrg")
  timelineEvents TimelineEvent[]        @relation("TimelineOrgs")
  tags           EntityTag[]            @relation("TaggedOrganization")

  @@index([projectId])
  @@index([deletedAt])
  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  characterId    String       @map("character_id") @db.Uuid
  character      Character    @relation(fields: [characterId], references: [id], onDelete: Cascade)

  role        String?
  rank        String?
  description String?
  startDate   String? @map("start_date")
  endDate     String? @map("end_date")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, characterId])
  @@map("organization_members")
}

model OrganizationRelation {
  id        String       @id @default(uuid()) @db.Uuid
  fromOrgId String       @map("from_org_id") @db.Uuid
  fromOrg   Organization @relation("FromOrg", fields: [fromOrgId], references: [id], onDelete: Cascade)
  toOrgId   String       @map("to_org_id") @db.Uuid
  toOrg     Organization @relation("ToOrg", fields: [toOrgId], references: [id], onDelete: Cascade)

  type        String
  label       String?
  description String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fromOrgId, toOrgId, type])
  @@map("organization_relations")
}

// ============================================================
// LORE
// ============================================================

model LoreEntry {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title    String
  category String
  content  String?
  notes    String?
  status   String @default("planned")
  progress Int    @default(0)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tags EntityTag[] @relation("TaggedLore")

  linksFrom LoreLink[] @relation("FromLore")
  linksTo   LoreLink[] @relation("ToLore")

  @@index([projectId])
  @@index([projectId, category])
  @@index([deletedAt])
  @@map("lore_entries")
}

model LoreLink {
  id         String    @id @default(uuid()) @db.Uuid
  fromLoreId String    @map("from_lore_id") @db.Uuid
  fromLore   LoreEntry @relation("FromLore", fields: [fromLoreId], references: [id], onDelete: Cascade)
  toLoreId   String    @map("to_lore_id") @db.Uuid
  toLore     LoreEntry @relation("ToLore", fields: [toLoreId], references: [id], onDelete: Cascade)

  type        String   @default("related")
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([fromLoreId, toLoreId])
  @@map("lore_links")
}

// ============================================================
// TIMELINE
// ============================================================

model TimelineEvent {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title         String
  description   String?
  narrativeDate String? @map("narrative_date")
  sortKey       String? @map("sort_key")
  order         Int     @default(0)

  locationId String?   @map("location_id") @db.Uuid
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  characters    TimelineEventCharacter[]
  organizations Organization[]           @relation("TimelineOrgs")
  scenes        Scene[]                  @relation("TimelineScenes")

  @@index([projectId])
  @@index([projectId, sortKey])
  @@index([deletedAt])
  @@map("timeline_events")
}

model TimelineEventCharacter {
  id              String        @id @default(uuid()) @db.Uuid
  timelineEventId String        @map("timeline_event_id") @db.Uuid
  timelineEvent   TimelineEvent @relation(fields: [timelineEventId], references: [id], onDelete: Cascade)
  characterId     String        @map("character_id") @db.Uuid
  character       Character     @relation(fields: [characterId], references: [id], onDelete: Cascade)

  role String?

  @@unique([timelineEventId, characterId])
  @@map("timeline_event_characters")
}

// ============================================================
// MÉDIATHÈQUE
// ============================================================

model Media {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  filename     String
  originalName String  @map("original_name")
  mimeType     String  @map("mime_type")
  size         Int
  url          String
  type         String  @default("image")
  category     String?
  description  String?
  alt          String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  entityType String? @map("entity_type")
  entityId   String? @map("entity_id")

  tags EntityTag[] @relation("TaggedMedia")

  @@index([projectId])
  @@index([entityType, entityId])
  @@index([deletedAt])
  @@map("media")
}

// ============================================================
// TAGS
// ============================================================

model Tag {
  id        String  @id @default(uuid()) @db.Uuid
  projectId String  @map("project_id") @db.Uuid
  name      String
  color     String?

  createdAt DateTime    @default(now()) @map("created_at")
  entities  EntityTag[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("tags")
}

model EntityTag {
  id    String @id @default(uuid()) @db.Uuid
  tagId String @map("tag_id") @db.Uuid
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  entityType String @map("entity_type")
  entityId   String @map("entity_id")

  projectId String?  @map("project_id") @db.Uuid
  project   Project? @relation("TaggedProject", fields: [projectId], references: [id], onDelete: Cascade)

  sceneId String? @map("scene_id") @db.Uuid
  scene   Scene?  @relation("TaggedScene", fields: [sceneId], references: [id], onDelete: Cascade)

  characterId String?    @map("character_id") @db.Uuid
  character   Character? @relation("TaggedCharacter", fields: [characterId], references: [id], onDelete: Cascade)

  locationId String?   @map("location_id") @db.Uuid
  location   Location? @relation("TaggedLocation", fields: [locationId], references: [id], onDelete: Cascade)

  organizationId String?       @map("organization_id") @db.Uuid
  organization   Organization? @relation("TaggedOrganization", fields: [organizationId], references: [id], onDelete: Cascade)

  loreEntryId String?    @map("lore_entry_id") @db.Uuid
  loreEntry   LoreEntry? @relation("TaggedLore", fields: [loreEntryId], references: [id], onDelete: Cascade)

  mediaId String? @map("media_id") @db.Uuid
  media   Media?  @relation("TaggedMedia", fields: [mediaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("entity_tags")
}

// ============================================================
// SHARING / COLLABORATION
// ============================================================

model ProjectCollaborator {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("editor") // "editor" | "viewer"
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_collaborators")
}

model ProjectInvite {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  token     String   @unique
  role      String   @default("editor") // "editor" | "viewer"
  createdById String @map("created_by_id") @db.Uuid
  createdBy  User    @relation(fields: [createdById], references: [id])
  expiresAt DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([token])
  @@map("project_invites")
}

// ============================================================
// READING PROGRESS
// ============================================================

model ReadingProgress {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String   @map("project_id") @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sceneId   String?  @map("scene_id") @db.Uuid
  scene     Scene?   @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  blockId   String?  @map("block_id") @db.Uuid
  block     SceneBlock? @relation(fields: [blockId], references: [id], onDelete: SetNull)
  wordIndex Int      @default(0) @map("word_index")
  percentage Float   @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("reading_progress")
}

{
  "name": "narra",
  "version": "0.14.2",
  "private": true,
  "scripts": {
    "dev": "tsx server.ts",
    "build": "prisma generate && next build",
    "start": "NODE_ENV=production tsx server.ts",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test:animations": "tsx --test tests/scene-animations.test.ts",
    "test:navigation": "tsx --test tests/studio-navigation.test.ts",
    "test:import": "tsx --test tests/scene-script-parser.test.ts",
    "test:studio-patch": "node tests/studio-patch.browser.cjs",
    "test:timeline": "tsx --test tests/studio-timeline.test.ts",
    "test:selection": "tsx --test tests/studio-selection-music.test.ts",
    "test:editor-api": "tsx tests/editor-update.api.ts",
    "test:editor-browser": "node tests/editor-update.browser.cjs",
    "test:reading-order": "tsx --test tests/narrative-order.test.ts",
    "test:reading-browser": "node tests/reader-order.browser.cjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/client": "^5.20.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "ws": "^8.21.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

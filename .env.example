# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/narra?schema=public"

# Narra (NEXTAUTH_URL / NEXTAUTH_SECRET remain accepted as legacy aliases)
NARRA_BASE_URL="http://localhost:3000"
NARRA_SESSION_SECRET="change-me-with-at-least-32-random-characters"

# Kyros SSO v4
KYROS_SSO_VERSION="v4"
KYROS_BASE_URL="http://localhost:3001"
KYROS_FALLBACK_BASE_URL="https://kyros.mhemery.fr"
KYROS_CLIENT_ID=""
KYROS_CLIENT_SECRET=""
KYROS_REQUESTED_SCOPE="profile email"
KYROS_REQUIRED_SCOPES="profile email"
KYROS_ISSUER="kyros"
KYROS_AUDIENCE="kyros-modules"
KYROS_RESOURCE_AUDIENCE="kyros:sso:narra"
KYROS_EDITION="standard"
KYROS_APPLICATION_SCOPE="standard"
KYROS_TIMEOUT_SECONDS="5"

# Optional endpoint overrides. Discovery from /.well-known/kyros-configuration is used by default.
# KYROS_AUTHORIZE_URL="http://localhost:3001/authorize"
# KYROS_TOKEN_URL="http://localhost:3001/token"
# KYROS_PAR_URL="http://localhost:3001/par"
# KYROS_JWKS_URL="http://localhost:3001/sso/v4/jwks"

# Legacy alias kept temporarily for local compatibility
NEXTAUTH_SECRET="change-me-with-at-least-32-random-characters"
